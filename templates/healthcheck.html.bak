{% load custom_filters %}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>3PAR Health Check</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            margin: 20px;
        }

        h1 {
            text-align: center;
        }

        .container {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
        }

        .card {
            flex: 1;
            background: white;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        }

        .card h2 {
            margin-top: 0;
        }

        .nodes span {
            display: inline-block;
            background: #e3f2fd;
            padding: 5px 8px;
            margin: 2px;
            border-radius: 4px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th,
        td {
            padding: 10px;
            text-align: center;
            border: 1px solid #ddd;
        }

        th {
            background-color: #2c3e50;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        .low {
            background-color: #e74c3c;
            color: white;
        }

        .medium {
            background-color: #f39c12;
            color: white;
        }

        .good {
            background-color: #2ecc71;
            color: white;
        }

        .red-bg {
            background-color: #ffcccc;
        }

        .node-box {
            display: inline-block;
            padding: 6px 10px;
            margin: 2px;
            border: 1px solid #333;
            border-radius: 5px;
            background-color: #f2f2f2;
            font-weight: bold;
        }

        .degraded {
            background-color: #ffcccc;
            /* light red */
        }

        tr.degraded {
            background-color: #ffcccc;
        }

        tr.red-bg {
            background-color: #ffcccc;
        }
    </style>
</head>

<body>

    <h1>Health Check Dashboard</h1>

    <!-- Top Cards -->
    <div class="container">

        <!-- Node Info -->
        <div class="card">
            <h2>Node Info</h2>
            <p><strong>Name:</strong> {{ gzp_3par_node_info.name }}</p>
        </div>

        <!-- Summary -->
        <div class="card">
            <h2>Summary</h2>
            <p><strong>Total Nodes:</strong> {{ gzp_3par_node_info.totalNodes }}</p>
            <p><strong>Master Node:</strong> {{ gzp_3par_node_info.masterNode }}</p>

            <p><strong>Online Nodes:</strong></p>

            <div>
                {% for node in gzp_3par_node_info.onlineNodes %}
                <span class="node-box">{{ node }}</span>
                {% endfor %}
            </div>
            <p><strong>Total CPG:</strong> {{ gzp_3par_cpg_info.total }}</p>
            <p><strong>Total Cages:</strong> {{ gzp_3par_cage_info | length }} | <strong style="background-color: #e2857a;">Degraded Cages: {{ degraded_cage_count }} </strong></p>
            <p><strong>Total Disks:</strong> {{ gzp_3par_disk_info | length }} | <strong style="background-color: #e2857a;">Degraded Disk: {{ degraded_disk_count }} </strong></p>
            <p><strong>Total Alarms:</strong> <strong style="background-color: #e2857a;"> {{ gzp_3par_alarm_info | length }} </strong></p>
        </div>

    </div>

    <button onclick="toggleTable('cpgTable', this)">Show CPG Info</button>
    <div id="cpgTable" style="display: none;">
        <h3>CPG Info:</h3>

        <table border="1" cellpadding="5">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Total (GB)</th>
                <th>Free (GB)</th>
                <th>Free %</th>
            </tr>

            {% for cpg in gzp_3par_cpg_info.members %}
            <tr>
                <td>{{ cpg.id }}</td>
                <td>{{ cpg.name }}</td>
                <td>{{ cpg.totalSpaceMiB|to_gb|floatformat:2 }}</td>
                <td>{{ cpg.freeSpaceMiB|to_gb|floatformat:2 }}</td>

                <td class="
                {% if cpg.freeSpaceMiB|free_percent:cpg.totalSpaceMiB < 15 %}
                    low
                {% elif cpg.freeSpaceMiB|free_percent:cpg.totalSpaceMiB < 30 %}
                    medium
                {% else %}
                    good
                {% endif %}
            ">
                    {{ cpg.freeSpaceMiB|free_percent:cpg.totalSpaceMiB|floatformat:2 }}%
                </td>
            </tr>
            {% endfor %}
        </table>
    </div>

    </br>

    <button onclick="toggleTable('cageTable', this)">Show Cage Info</button>


    <div id="cageTable" style="display: none; transition: all 0.3s;">
        <h3>Cage Info</h3>

        <table border="1" cellpadding="5">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Loop A</th>
                <th>Loop B</th>
            </tr>

            {% for cage in gzp_3par_cage_info %}
            <tr class="{% if not cage.loopA or not cage.loopB %}red-bg{% endif %}">
                <td>{{ cage.id }}</td>
                <td>{{ cage.name }}</td>
                <td>{{ cage.loopA|default:"Absent" }}</td>
                <td>{{ cage.loopB|default:"Absent" }}</td>
            </tr>
            {% endfor %}
        </table>
    </div>

    </br>
    <button onclick="toggleTable('diskTable', this)">Show Disk Info</button>


    <div id="diskTable" style="display: none; transition: all 0.3s;">
        <h3>Disk Info</h3>

        <table border="1" cellpadding="5">
            <tr>
                <th>ID</th>
                <th>Location</th>
                <th>Type</th>
                <th>State</th>
            </tr>

            {% for disk in gzp_3par_disk_info %}
            <tr class="{% if disk.state != 'normal' %}degraded{% endif %}">
                <td>{{ disk.id }}</td>
                <td>{{ disk.cagePos }}</td>
                <td>{{ disk.type}}</td>
                <td>{{ disk.state }}</td>
            </tr>
            {% endfor %}
        </table>
    </div>

    </br>
    <button onclick="toggleTable('alarmTable', this)">Show Alarm Info</button>


    <div id="alarmTable" style="display: none; transition: all 0.3s;">
        <h3>Alarm Info</h3>

        <table border="1" cellpadding="5">
            <tr>
                <th>ID</th>
                <th>State</th>
                <th>Time</th>
                <th>Severity</th>
                <th>Message</th>
            </tr>

            {% for alarm in gzp_3par_alarm_info %}
            <tr>
                <td>{{ alarm.Id }}</td>
                <td>{{ alarm.State }}</td>
                <td>{{ alarm.Time}}</td>
                <td>{{ alarm.Severity }}</td>
                <td>{{ alarm.Message }}</td>
            </tr>
            {% endfor %}
        </table>
    </div>
    
</body>

</html>

<script>
    function toggleTable(id, btn) {
        var table = document.getElementById(id);

        if (table.style.display === "none") {
            table.style.display = "block";
            btn.innerText = "Hide " + btn.innerText.replace("Show ", "");
        } else {
            table.style.display = "none";
            btn.innerText = "Show " + btn.innerText.replace("Hide ", "");
        }
    }
</script>